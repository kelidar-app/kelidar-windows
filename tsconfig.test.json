{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsc/test",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "tests/**/*",
    "src/main/**/*",
    "src/shared/**/*",
    "src/renderer/i18n/*.json",
    "src/renderer/i18n/index.ts",
    "src/renderer/features/terminal/themes.ts",
    "src/renderer/features/hosts/host-search.ts",
    "src/renderer/lib/fuzzy.ts",
    "src/renderer/app/key-combos.ts",
    "src/renderer/features/hosts/connection-draft.ts",
    "src/renderer/features/hosts/drag-rules.ts",
    "src/renderer/features/terminal/layout.ts",
    "src/renderer/stores/terminal-ui.ts"
  ]
}
